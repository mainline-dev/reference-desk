# Copy to .env (which git ignores) and add your key. The environment overrides .env.

# OpenRouter, or anything else that speaks the OpenAI API (Ollama: http://localhost:11434/v1).
REFDESK_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek V3 0324: a chat model, not a reasoning one. SiliconFlow serves it with
# zero data retention. deepseek/deepseek-chat (DeepSeek V3, via DeepInfra) is the other.
REFDESK_MODEL=deepseek/deepseek-chat-v3-0324

REFDESK_API_KEY=

# true: every request asks OpenRouter for zero data retention providers only, and stops
# if none will serve the model. Set "ZDR only" in your OpenRouter privacy settings too,
# or zdr requests may also go to Safety Retention endpoints.
REFDESK_ZDR=true
